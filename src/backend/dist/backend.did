type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type UserProfile = 
 record {
   defaultCurrency: Currency;
   name: text;
   themePreference: ThemePreference;
 };
type Time = int;
type ThemePreference = 
 variant {
   dark;
   light;
 };
type SavingGoalId = text;
type SavingGoalDTO = 
 record {
   currency: Currency;
   currentSavedAmount: float64;
   deadline: opt Time;
   name: text;
   targetAmount: float64;
 };
type SavingGoal = 
 record {
   currency: Currency;
   currentSavedAmount: float64;
   deadline: opt Time;
   id: SavingGoalId;
   name: text;
   targetAmount: float64;
 };
type Result = 
 variant {
   err: Error;
   ok;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type EmergencyFund = 
 record {
   bankAmount: float64;
   cashAmount: float64;
 };
type Currency = 
 variant {
   eur;
   usd;
 };
service : {
  __accessControlState: () -> (reserved) query;
  __emergencyFunds: (ko: opt principal, count: opt nat) ->
   (vec record {
          principal;
          EmergencyFund;
        }) query;
  __emptyEmergencyFund: () -> (EmergencyFund) query;
  __nextId: () -> (nat) query;
  __savingGoals: () -> (reserved) query;
  __userProfiles: (ko: opt principal, count: opt nat) ->
   (vec record {
          principal;
          UserProfile;
        }) query;
  __userStatistics: () -> (reserved) query;
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result);
  _internet_identity_sign_in_start: () -> (blob);
  addToCurrentSavedAmount: (id: SavingGoalId, amount: float64) -> ();
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  createSavingGoal: (data: SavingGoalDTO) -> (SavingGoalId);
  deleteSavingGoal: (id: SavingGoalId) -> ();
  getAllEmergencyFunds: () -> (vec record {
                                     principal;
                                     EmergencyFund;
                                   }) query;
  getAllSavingGoals: () -> (vec SavingGoal) query;
  getCallerUserProfile: () -> (opt UserProfile) query;
  getCallerUserRole: () -> (UserRole) query;
  getEmergencyFund: () -> (EmergencyFund) query;
  getFilteredSavingGoals: (currency: opt Currency, deadline: opt Time) ->
   (vec SavingGoal) query;
  getSavingGoal: (id: SavingGoalId) -> (opt SavingGoal) query;
  getStatistics: () ->
   (opt
     record {
       biggestAchievement: float64;
       completedGoals: nat;
       totalGoalsCreated: nat;
       totalSavedAmount: float64;
     }) query;
  getUserProfile: (user: principal) -> (opt UserProfile) query;
  isCallerAdmin: () -> (bool) query;
  saveCallerUserProfile: (profile: UserProfile) -> ();
  updateEmergencyFund: (bank: float64, cash: float64) -> ();
  updateSavingGoal: (id: SavingGoalId, data: SavingGoalDTO) -> ();
}
